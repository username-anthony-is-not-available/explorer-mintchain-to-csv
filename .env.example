# Your EVM wallet address for fetching transactions
WALLET_ADDRESS=your_wallet_address_here

# API keys for blockchain explorers (optional, but recommended for higher rate limits)
# Supports single key or comma-separated keys for automatic key rotation (e.g. key1,key2,key3)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_API_KEY=
POLYGON_API_KEY=

# Custom RPC/Explorer API URLs (optional, overrides default URLs for each chain)
# RPC_URL_MINTCHAIN=https://custom-mintchain-rpc.com
# RPC_URL_ETHERSCAN=https://custom-etherscan-rpc.com
# RPC_URL_BASESCAN=https://custom-basescan-rpc.com
# RPC_URL_ARBISCAN=https://custom-arbiscan-rpc.com
# RPC_URL_OPTIMISM=https://custom-optimism-rpc.com
# RPC_URL_POLYGON=https://custom-polygon-rpc.com

# Optional Prometheus textfile output path for batch run & API metrics
# METRICS_FILE=output/metrics.prom
